{
  "name": "flavio-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync-algolia": "tsx --env-file=.env.local scripts/sync-algolia.ts",
    "sync-contentstack-home": "tsx --env-file=.env.local scripts/sync-contentstack-home.ts",
    "seed-contentstack-contacts": "tsx --env-file=.env.local scripts/seed-contentstack-contacts.ts",
    "setup-contentstack-content-types": "tsx --env-file=.env.local scripts/setup-contentstack-content-types.ts",
    "seed-contentstack-site-content": "tsx --env-file=.env.local scripts/seed-contentstack-site-content.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@contentstack/delivery-sdk": "^5.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@shopify/storefront-api-client": "^2.0.0",
    "@vercel/otel": "^2.1.3",
    "algoliasearch": "^5.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-instantsearch": "^7.46.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  }
}
