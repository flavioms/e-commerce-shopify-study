# Copy this file to .env.local and fill in real values.
# See README.md for where each token comes from and what it's used for.

# --- Shopify Storefront API -------------------------------------------------
# Store domain, e.g. your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Storefront API private access token (Settings > Apps > Develop apps).
# Server-side only — never exposed to the browser.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# --- Contentstack ------------------------------------------------------------
CONTENTSTACK_API_KEY=
# Read-only Delivery Token, used by the app itself at request time.
CONTENTSTACK_DELIVERY_TOKEN=
# Read/write Management Token, used only by the scripts/ CMS setup and seed
# scripts (npm run setup-contentstack-content-types / seed-contentstack-*).
# Never used by the app itself — keep it out of anything client-facing.
CONTENTSTACK_MANAGEMENT_TOKEN=

# --- Algolia -------------------------------------------------------------
ALGOLIA_APP_ID=
# Admin API key — write access. Server-side only, used by scripts/sync-algolia.ts.
ALGOLIA_ADMIN_KEY=
ALGOLIA_INDEX_NAME=products

# Client-side (browser) search. Must be the Search-Only API key from your
# Algolia dashboard (Settings > API Keys) — never the admin key above.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=products
