# Copy this file to .env.local and fill in real values.
# See README.md for where each token comes from and what it's used for.

# --- Site ---------------------------------------------------------------
# Canonical public URL (no trailing slash). Used for metadataBase, sitemap.xml,
# robots.txt, and JSON-LD — set this to the real deployed domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Observability (OpenTelemetry -> New Relic) ------------------------------
# New Relic's ingest license key (Account settings > API keys > "Ingest -
# License"), doubles as the OTLP `api-key` header. Optional — leave unset and
# src/instrumentation.ts still registers OpenTelemetry, it just won't export
# anywhere (safe for local dev without this credential).
NEW_RELIC_LICENSE_KEY=
# Only needed for an EU-region New Relic account — otherwise leave unset to
# use the US endpoint (https://otlp.nr-data.net:4318). EU accounts use
# https://otlp.eu01.nr-data.net:4318.
NEW_RELIC_OTLP_ENDPOINT=

# --- Shopify Storefront API -------------------------------------------------
# Store domain, e.g. your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Storefront API private access token (Settings > Apps > Develop apps).
# Server-side only — never exposed to the browser.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# --- Contentful ------------------------------------------------------------
CONTENTFUL_SPACE_ID=
# Defaults to "master" if unset — only needed for a non-default environment.
CONTENTFUL_ENVIRONMENT=
# Read-only Content Delivery API token, used by the app itself at request time.
CONTENTFUL_DELIVERY_TOKEN=
# Read/write Content Management API token, used only by the scripts/ CMS setup
# and seed scripts (npm run setup-contentful-content-types / seed-contentful-*,
# sync-contentful-home). Never used by the app itself — keep it out of
# anything client-facing.
CONTENTFUL_MANAGEMENT_TOKEN=

# --- Algolia -------------------------------------------------------------
ALGOLIA_APP_ID=
# Admin API key — write access. Server-side only, used by scripts/sync-algolia.ts.
ALGOLIA_ADMIN_KEY=
ALGOLIA_INDEX_NAME=products

# Client-side (browser) search. Must be the Search-Only API key from your
# Algolia dashboard (Settings > API Keys) — never the admin key above.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=products
